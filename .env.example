# --- Providers: "openai" (needs OPENAI_API_KEY) or "fake" (offline, deterministic: tests/CI/demo) ---
RAG_LLM_PROVIDER=fake
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_ESCALATION_MODEL=        # e.g. gpt-6-luna: re-asked when the primary refuses (docs/evaluation.md)
RAG_LLM_ESCALATION_EFFORT=low    # reasoning effort of the escalation model; empty = non-reasoning model
RAG_LLM_FALLBACK_MODEL=          # used when the primary fails (outage, rate limit, parse error)
RAG_LLM_TIMEOUT_S=30
RAG_LLM_MAX_RETRIES=2
RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=256
OPENAI_API_KEY=

# --- Vector store: empty URL => embedded local Qdrant at RAG_QDRANT_PATH ---
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
RAG_QDRANT_PATH=.qdrant
RAG_COLLECTION_ALIAS=docs

# --- Retrieval ---
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_TOP_K_RERANK=5
RAG_RERANKER=none            # none | cross-encoder | llm
RAG_MIN_RELEVANCE=0.0        # threshold on the reranker score; ignored when RERANKER=none

# --- Semantic cache (stored in Qdrant, shared by replicas) ---
RAG_CACHE_ENABLED=true
RAG_CACHE_THRESHOLD=0.97
RAG_CACHE_TTL_S=3600

# --- Redis (ingestion stream, rate limits, token budgets). Empty => in-process fallback ---
RAG_REDIS_URL=

# --- API ---
RAG_API_KEYS=dev-key:tenant-a   # comma separated key:tenant pairs
RAG_API_THREADS=64              # concurrent pipelines per replica
RAG_RATE_LIMIT_PER_MIN=60       # per tenant, cluster-wide with Redis
RAG_TENANT_DAILY_TOKENS=0       # 0 = unlimited
RAG_MAX_UPLOAD_MB=25
RAG_UPLOAD_DIR=data/uploads     # RWX shared volume in a cluster
RAG_MAX_HISTORY_MESSAGES=12
RAG_LOG_JSON=false

# --- LangSmith (tracing + evals) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=open-rag
